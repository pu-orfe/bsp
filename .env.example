# Environment variables for Drupal UI Automation

# Base URL of the Drupal site (required for all operations)
BASE_URL=https://your-drupal-site.com

# Default login URL (optional - defaults to BASE_URL if not set)
# Only set this if your login page is at a different URL than the base
# DEFAULT_LOGIN_URL=https://your-drupal-site.com/user/login

# Host ports published by docker-compose (optional)
# The container always listens on 3000/8080/5900 internally; these only change
# the host side. Handy when something else already owns the default:
#   - 3000 and 8080 are the most contended dev ports
#   - on macOS, AirPlay Receiver holds 5000 and 7000
# The example scripts follow BSP_API_PORT, or set API_BASE to a full URL.
# BSP_API_PORT=3000
# BSP_NOVNC_PORT=8080
# BSP_VNC_PORT=5900

# Extra HTTP headers applied to every browser request (optional)
# JSON object of header name/value pairs. Useful when the site sits behind a
# WAF/bot filter that needs a bypass header to let automation through.
# Example (Princeton Cloudflare bot-detection bypass):
# EXTRA_HTTP_HEADERS={"x-wdsoit-bot-bypass":"true"}

# Debug logging flag (set to 'true' to enable detailed logging to console and log files)
# DEBUG_LOGGING=true

# Keepalive configuration (for maintaining CAS/session cookies)
# Automatically refreshes session to prevent expiration - critical for CAS/Shibboleth auth
# KEEPALIVE_ENABLED=true               # Enable/disable automatic keepalive (default: true)
# KEEPALIVE_INTERVAL_MINUTES=60        # Keepalive interval in minutes (default: 60, range: 5-1440)
# KEEPALIVE_MAX_FAILURES=3             # Circuit breaker threshold for consecutive failures (default: 3)
#
# Important:
# - Minimum interval: 5 minutes (prevents server overload)
# - Maximum interval: 1440 minutes/24 hours (prevents sessions from never refreshing)
# - Manual keepalive endpoint is rate-limited to once per minute
